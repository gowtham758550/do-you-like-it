{
  "manifest_version": 3,
  "name": "Do You Like It?",
  "short_name": "Do You Like It",
  "version": "0.1.0",
  "description": "Hide prices while you shop together. Let them pick what they love. The price is your problem.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Do You Like It?",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-hiding": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Hide or show prices"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.in/*", "*://*.flipkart.com/*", "*://*.myntra.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
