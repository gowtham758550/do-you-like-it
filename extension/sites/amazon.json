{
  "$schema": "../../schema/site.schema.json",
  "id": "amazon",
  "name": "Amazon",
  "domains": [
    "amazon.in",
    "amazon.com",
    "amazon.co.uk",
    "amazon.de",
    "amazon.ca",
    "amazon.com.au",
    "amazon.ae"
  ],
  "currency": "INR",
  "regions": {
    "amazon.in": {
      "name": "Amazon India",
      "currency": "INR"
    },
    "amazon.com": {
      "name": "Amazon US",
      "currency": "USD"
    },
    "amazon.co.uk": {
      "name": "Amazon UK",
      "currency": "GBP"
    },
    "amazon.de": {
      "name": "Amazon Germany",
      "currency": "EUR"
    },
    "amazon.ca": {
      "name": "Amazon Canada",
      "currency": "CAD"
    },
    "amazon.com.au": {
      "name": "Amazon Australia",
      "currency": "AUD"
    },
    "amazon.ae": {
      "name": "Amazon UAE",
      "currency": "AED"
    }
  },
  "maintainers": [
    "doyoulikeit"
  ],
  "lastVerified": "2026-11-21",
  "hide": {
    "price": [
      ".a-price",
      ".a-text-price",
      ".apex-pricetopay-value",
      ".apex-price-to-pay-value",
      ".apex-basisprice-value",
      ".apex-basis-price-value",
      ".apex-priceperunit-value",
      ".basisPrice",
      ".pricePerUnit",
      "#tp_price_block_total_price_ww"
    ],
    "discount": [
      ".savingsPercentage",
      ".s-coupon-unclipped",
      ".s-coupon-clipped",
      "[id$='_couponBadge']"
    ]
  },
  "remove": {
    "deals": [
      ".a-badge[data-a-badge-type='deal']",
      "#dealBadge_feature_div"
    ],
    "unitPrice": [
      "span.a-size-base:has(> .a-price.a-text-price)",
      ".contains-ppu",
      ".centralizedApexPricePerUnitCSS",
      "span.aok-relative:has(.apex-priceperunit-value)",
      "[class*='ppu-info']"
    ],
    "ads": [
      "div[id^='ape_'][id$='_placement']"
    ],
    "offers": [
      "#vsxoffers_feature_div",
      "#inemi_feature_div",
      "#installmentCalculator_feature_div"
    ],
    "priceFilters": [
      "#priceRefinements",
      "[id*='p_n_pct-off-with-tax']"
    ],
    "sortOptions": [
      "#s-result-sort-select option[value^='price']",
      ".a-popover li:has(a[data-value*='price-asc-rank'])",
      ".a-popover li:has(a[data-value*='price-desc-rank'])"
    ]
  },
  "product": {
    "card": "[data-component-type='s-search-result']",
    "idAttr": "data-asin",
    "title": "a h2 span",
    "image": "img.s-image",
    "price": ".a-price:not(.a-text-price) .a-offscreen",
    "likeAnchor": ".s-product-image-container"
  },
  "productPage": {
    "urlPattern": "/(?:dp|gp/product)/([A-Z0-9]{10})",
    "title": "#productTitle",
    "image": "#landingImage",
    "price": "#corePriceDisplay_desktop_feature_div .priceToPay",
    "likeAnchor": "#titleSection"
  },
  "productUrl": "https://www.{domain}/dp/{id}",
  "ignore": [
    "#nav-search"
  ],
  "genericDetection": true
}
